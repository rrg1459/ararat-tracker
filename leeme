🛠️ Código SQL para crear las tablas en Supabase

Puedes ir al SQL Editor en tu panel de Supabase, pegar este código y ejecutarlo (Run). Creará las tablas y sus relaciones automáticamente:
-- 1. Crear tabla de perfiles (usuarios de la app)
create table profiles (
  id uuid references auth.users on delete cascade primary key,
  updated_at timestamp with time zone,
  full_name text,
  role text default 'operator'
);

-- 2. Crear tabla de personas
create table people (
  id uuid default gen_random_uuid() primary key,
  created_at timestamp with time zone default now(),
  id_number text unique not null,
  first_name text not null,
  last_name text not null,
  phone text,
  email text,
  birth_date date,
  person_type text check (person_type in ('member', 'visitor')) not null,
  invited_by_id uuid references people(id) on delete set null
);

-- 3. Crear tabla de registros de asistencia
create table attendance_logs (
  id uuid default gen_random_uuid() primary key,
  date date default current_date not null,
  person_id uuid references people(id) on delete cascade not null,
  registered_by uuid references profiles(id) on delete set null,
  notes text
);

